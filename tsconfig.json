{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@core/*": ["./src/app/core/*"],
      "@shared/*": ["./src/app/shared/*"],
      "@spartan-ng/helm/alert": ["./src/app/libs/alert/src/index.ts"],
      "@spartan-ng/helm/avatar": ["./src/app/libs/avatar/src/index.ts"],
      "@spartan-ng/helm/badge": ["./src/app/libs/badge/src/index.ts"],
      "@spartan-ng/helm/breadcrumb": ["./src/app/libs/breadcrumb/src/index.ts"],
      "@spartan-ng/helm/button": ["./src/app/libs/button/src/index.ts"],
      "@spartan-ng/helm/calendar": ["./src/app/libs/calendar/src/index.ts"],
      "@spartan-ng/helm/card": ["./src/app/libs/card/src/index.ts"],
      "@spartan-ng/helm/checkbox": ["./src/app/libs/checkbox/src/index.ts"],
      "@spartan-ng/helm/collapsible": ["./src/app/libs/collapsible/src/index.ts"],
      "@spartan-ng/helm/combobox": ["./src/app/libs/combobox/src/index.ts"],
