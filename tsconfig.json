      "@spartan-ng/helm/textarea": ["./src/app/libs/textarea/src/index.ts"],
      "@spartan-ng/helm/tooltip": ["./src/app/libs/tooltip/src/index.ts"],
      "@spartan-ng/helm/utils": ["./src/app/libs/utils/src/index.ts"],
      "@spartan-ng/helm/alert-dialog": ["./src/app/libs/alert-dialog/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
