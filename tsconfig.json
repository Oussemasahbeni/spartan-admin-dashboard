      "@spartan-ng/helm/date-picker": ["./src/app/libs/date-picker/src/index.ts"],
      "@spartan-ng/helm/dialog": ["./src/app/libs/dialog/src/index.ts"],
      "@spartan-ng/helm/dropdown-menu": ["./src/app/libs/dropdown-menu/src/index.ts"],
      "@spartan-ng/helm/empty": ["./src/app/libs/empty/src/index.ts"],
      "@spartan-ng/helm/field": ["./src/app/libs/field/src/index.ts"],
      "@spartan-ng/helm/input": ["./src/app/libs/input/src/index.ts"],
      "@spartan-ng/helm/input-group": ["./src/app/libs/input-group/src/index.ts"],
      "@spartan-ng/helm/input-otp": ["./src/app/libs/input-otp/src/index.ts"],
      "@spartan-ng/helm/kbd": ["./src/app/libs/kbd/src/index.ts"],
      "@spartan-ng/helm/label": ["./src/app/libs/label/src/index.ts"],
      "@spartan-ng/helm/pagination": ["./src/app/libs/pagination/src/index.ts"],
      "@spartan-ng/helm/popover": ["./src/app/libs/popover/src/index.ts"],
      "@spartan-ng/helm/radio-group": ["./src/app/libs/radio-group/src/index.ts"],
      "@spartan-ng/helm/resizable": ["./src/app/libs/resizable/src/index.ts"],
      "@spartan-ng/helm/scroll-area": ["./src/app/libs/scroll-area/src/index.ts"],
      "@spartan-ng/helm/select": ["./src/app/libs/select/src/index.ts"],
      "@spartan-ng/helm/separator": ["./src/app/libs/separator/src/index.ts"],
      "@spartan-ng/helm/sheet": ["./src/app/libs/sheet/src/index.ts"],
      "@spartan-ng/helm/sidebar": ["./src/app/libs/sidebar/src/index.ts"],
      "@spartan-ng/helm/skeleton": ["./src/app/libs/skeleton/src/index.ts"],
      "@spartan-ng/helm/sonner": ["./src/app/libs/sonner/src/index.ts"],
      "@spartan-ng/helm/spinner": ["./src/app/libs/spinner/src/index.ts"],
